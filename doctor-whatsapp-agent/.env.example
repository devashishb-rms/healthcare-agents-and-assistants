# --- LLM (Anthropic). Or run `ant auth login` and leave the key unset. ---
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=           # only if the key is org-level (not created inside a workspace); wrkspc_...
AGENT_MODEL=claude-opus-5-5
CLASSIFIER_MODEL=claude-haiku-5-5
AGENT_EFFORT=low
ENABLE_FALLBACKS=false
DRY_RUN=true                      # set false only when WhatsApp credentials are real

# --- WhatsApp Cloud API (Meta for Developers > your app > WhatsApp) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pick-a-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v22.0

# --- Doctor / clinic ---
DOCTOR_CONTROL_NUMBER=919999900000   # doctor's second phone (digits only). Drafts & emergency pages go here.
DOCTOR_NAME=Mehta
DOCTOR_QUALIFICATIONS=MBBS, MD (Paediatrics)
SPECIALITY=Paediatrician
NMC_REG_NO=MMC-12345
CLINIC_NAME=Mehta Clinic
CITY=Mumbai
CLINIC_PHONE=+91 98765 43210
ASSISTANT_NAME=Seva
REGIONAL_LANGUAGES=Marathi
DEFAULT_MODE=auto                 # auto | draft | off
BACKOFF_MINUTES=10

# --- Data ---
DATABASE_URL=sqlite:///./sevadesk.db
KB_PATH=data/clinic_kb.json
CALENDAR_PATH=data/calendar.json
REPORTS_PATH=data/reports.json

# --- Optional: Indic voice-note transcription ---
SARVAM_API_KEY=
